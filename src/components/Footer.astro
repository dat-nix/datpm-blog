---
const year = new Date().getFullYear();
---
<style>
  footer {
    border-top: 2px solid var(--line);
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    color: var(--muted);
    background: var(--paper);
  }
  footer a {
    font-size: 11px;
    margin-left: 14px;
    color: var(--link);
  }
  @media (max-width: 560px) {
    footer {
      align-items: flex-start;
      flex-direction: column;
      padding: 14px;
    }
    footer a {
      margin-left: 0;
      margin-right: 12px;
    }
  }
</style>

<footer>
  <span>© {year} Phạm Minh Đạt · notes on security, CTFs, and software</span>
  <span>
    <a href="/rss.xml">rss</a>
    <a href="/about#pgp">pgp</a>
    <a href="https://github.com/datpm" target="_blank" rel="noopener">github</a>
  </span>
</footer>
