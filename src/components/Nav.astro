---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/about', label: 'About' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/writing', label: 'Writing' },
  { href: '/links', label: 'Links' },
];
---
<style>
  .datpm-nav { padding: 24px 0 0; }
  .datpm-nav-top { display: grid; grid-template-columns: 1fr; justify-items: center; gap: 18px; padding-bottom: 18px; }
  .datpm-nav-year { text-align: right; }
  .datpm-wordmark { color: var(--ink); font: normal 36px/.85 var(--serif); letter-spacing: -.06em; text-decoration: none; }
  .datpm-wordmark:hover { color: var(--accent); }
  .datpm-nav-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 26px; padding: 12px 0 13px; }
  .datpm-nav-links a { color: var(--ink); font: 700 13px var(--sans); text-decoration: none; }
  .datpm-nav-links a:hover, .datpm-nav-links a.active { color: var(--accent); }
  @media (max-width: 640px) {
    .datpm-nav { padding-top: 18px; }
    .datpm-nav-top { grid-template-columns: 1fr; align-items: center; }
    .datpm-wordmark { font-size: 32px; }
    .datpm-nav-links { justify-content: flex-start; gap: 17px; }
  }
  @media (max-width: 420px) {
    .datpm-nav-links { gap: 12px 16px; }
    .datpm-nav-links a { font-size: 12px; }
  }
</style>
<header class="datpm-nav">
  <div class="datpm-nav-top">
    <a class="datpm-wordmark" href="/">datpm</a>
  </div>
  <nav class="datpm-nav-links" aria-label="Main navigation">
    {links.map(link => <a href={link.href} class={currentPath === link.href || (link.href !== '/' && currentPath.startsWith(`${link.href}/`)) ? 'active' : ''}>{link.label}</a>)}
  </nav>
</header>
