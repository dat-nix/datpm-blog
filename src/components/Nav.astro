---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/writing', label: 'writing' },
  { href: '/ctf', label: 'ctf' },
  { href: '/projects', label: 'projects' },
  { href: '/about', label: 'about' },
];
---
<style>
  .nav {
    border-bottom: 2px solid var(--line);
    padding: 14px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    background: var(--paper);
  }
  .nav-name {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    background: none !important;
    color: var(--ink) !important;
    white-space: nowrap;
  }
  .nav-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }
  .nav-links a {
    font-size: 12px;
    font-family: var(--mono);
    text-decoration: none;
    border: 1px solid var(--line);
    padding: 5px 9px 4px;
    letter-spacing: 0;
    background: var(--paper);
    box-shadow: 2px 2px 0 var(--line);
    color: var(--ink);
    transition: transform 120ms ease, box-shadow 120ms ease, background 120ms ease, color 120ms ease;
  }
  .nav-links a:hover {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 var(--line);
  }
  .nav-links a.active {
    background: var(--ink);
    color: var(--paper);
  }
  .marquee-bar {
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 11px;
    padding: 6px 0;
    overflow: hidden;
    white-space: nowrap;
    border-bottom: 2px solid var(--line);
  }
  .marquee-inner {
    display: inline-block;
    min-width: max-content;
    animation: marquee 34s linear infinite;
    padding-left: 20px;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-45%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-inner { animation: none; }
  }
  @media (max-width: 760px) {
    .nav {
      padding: 12px 14px;
      gap: 12px;
    }
    .nav-links { gap: 6px; }
    .nav-links a {
      padding: 5px 8px 4px;
      box-shadow: 1px 1px 0 var(--line);
    }
  }
  @media (max-width: 560px) {
    .nav {
      align-items: stretch;
      flex-direction: column;
      padding: 12px 10px;
    }
    .nav-name { text-align: center; }
    .nav-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-content: stretch;
    }
    .nav-links a { text-align: center; }
    .marquee-bar {
      font-size: 10px;
      padding: 5px 0;
    }
  }
  @media (max-width: 420px) {
    .nav-links {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 4px;
    }
    .nav-links a {
      font-size: 10px;
      padding-inline: 3px;
    }
    .marquee-bar { display: none; }
  }
</style>

<nav class="nav">
  <a href="/" class="nav-name">datpm.com</a>
  <div class="nav-links">
    {links.map(l => (
      <a href={l.href} class={currentPath.startsWith(l.href) ? 'active' : ''}>
        {l.label}
      </a>
    ))}
  </div>
</nav>

<div class="marquee-bar">
  <span class="marquee-inner">
    ★ binary exploitation notes &nbsp;&nbsp;&nbsp;
    ★ CTF writeups and lab logs &nbsp;&nbsp;&nbsp;
    ★ RMIT Vietnam · IT Year 2 &nbsp;&nbsp;&nbsp;
    ★ small experiments, documented clearly &nbsp;&nbsp;&nbsp;
    ★ RSS available · no analytics &nbsp;&nbsp;&nbsp;
    ★ binary exploitation notes &nbsp;&nbsp;&nbsp;
    ★ CTF writeups and lab logs &nbsp;&nbsp;&nbsp;
    ★ RMIT Vietnam · IT Year 2 &nbsp;&nbsp;&nbsp;
    ★ small experiments, documented clearly &nbsp;&nbsp;&nbsp;
    ★ RSS available · no analytics &nbsp;&nbsp;&nbsp;
  </span>
</div>
