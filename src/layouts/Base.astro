---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'datpm.com', description = 'Security notes, CTF writeups, and software experiments.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title === 'datpm.com' ? title : `${title} · datpm.com`}</title>
  <link rel="alternate" type="application/rss+xml" title="datpm.com" href="/rss.xml" />
  <style>
    :root {
      --bg: #f6f4ee;
      --paper: #fffdf6;
      --paper-2: #f0ece2;
      --paper-3: #e8f0e8;
      --ink: #10100e;
      --muted: #625d52;
      --soft: #d8d1c2;
      --line: #181714;
      --accent: #116b45;
      --accent-2: #9dff6e;
      --accent-soft: #e1f0e5;
      --link: #3f2ca1;
      --code-bg: #ebe5d8;
      --mono: 'Courier New', Courier, monospace;
      --serif: Georgia, 'Times New Roman', Times, serif;
      --sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }
    *, *::before, *::after { box-sizing: border-box; }
    * { margin: 0; padding: 0; }
    html {
      font-family: var(--sans);
      background:
        radial-gradient(circle at 18% 6%, rgba(17, 107, 69, 0.16), transparent 28%),
        linear-gradient(90deg, rgba(16, 16, 14, 0.045) 1px, transparent 1px),
        linear-gradient(180deg, rgba(16, 16, 14, 0.035) 1px, transparent 1px),
        var(--bg);
      background-size: 100% 100%, 48px 48px, 48px 48px;
      color: var(--ink);
      font-size: 16px;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
    }
    body {
      min-height: 100vh;
      padding: 18px;
      color: var(--ink);
      display: grid;
      justify-items: center;
      align-items: start;
    }
    .site-shell {
      width: 100%;
      max-width: 1120px;
      margin-inline: auto;
      background: var(--paper);
      border: 2px solid var(--line);
      box-shadow: 10px 10px 0 var(--line);
      overflow: clip;
    }
    a {
      color: var(--link);
      text-underline-offset: 0.18em;
      text-decoration-thickness: 1px;
    }
    a:hover { background: var(--ink); color: var(--paper); text-decoration: none; }
    a:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
      background: var(--accent-soft);
      color: var(--ink);
    }
    ::selection { background: var(--ink); color: var(--paper); }
    code {
      font-family: var(--mono);
      font-size: 0.88em;
      background: var(--code-bg);
      padding: 0.12em 0.35em;
      border: 1px solid var(--soft);
    }
    pre {
      background: #10130f;
      color: #e9efe6;
      padding: 18px;
      overflow-x: auto;
      margin: 1.4em 0;
      border: 2px solid var(--line);
      border-left: 6px solid var(--accent);
      box-shadow: 4px 4px 0 var(--line);
    }
    pre code { background: none; color: inherit; padding: 0; font-size: 0.85em; }
    h1, h2, h3 {
      font-family: var(--serif);
      letter-spacing: 0;
    }
    blockquote {
      border-left: 5px solid var(--line);
      background: #f3f0e8;
      padding-left: 14px;
      padding: 12px 14px;
      color: var(--muted);
      margin: 1.2em 0;
      font-style: italic;
    }
    hr { border: none; border-top: 2px solid var(--line); margin: 2em 0; }
    img { max-width: 100%; border: 2px solid var(--line); }
    @media (max-width: 640px) {
      body {
        padding: 8px;
      }
      .site-shell {
        box-shadow: 6px 6px 0 var(--line);
      }
    }
  </style>
</head>
<body>
  <div class="site-shell">
    <slot />
  </div>
</body>
</html>
