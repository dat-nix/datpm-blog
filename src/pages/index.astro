---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const recentCTFs = [
  { name: 'TBCTF 2025', date: 'Jun' },
  { name: 'BYUCTF 2026', date: 'May' },
  { name: 'picoCTF', date: 'ongoing' },
];

const projects = [
  { name: 'RMIT CTF Program', status: 'running' },
  { name: 'NCT Workshop', status: 'done' },
  { name: 'Personal notes site', status: 'iterating' },
];
---
<Base>
  <Nav />
  <style>
    .hero {
      border-bottom: 2px solid var(--line);
      padding: clamp(28px, 5vw, 54px) 28px 30px;
      background:
        linear-gradient(135deg, rgba(17, 107, 69, 0.18), transparent 42%),
        linear-gradient(180deg, var(--paper), #f5f1e7),
        var(--paper);
    }
    .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.9fr);
      align-items: end;
      gap: clamp(24px, 5vw, 56px);
    }
    .hero-tag {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      border: 1px solid var(--line);
      display: inline-block;
      padding: 5px 9px 4px;
      margin-bottom: 26px;
      background: var(--accent-soft);
      box-shadow: 2px 2px 0 var(--line);
    }
    .hero-title {
      font-size: clamp(42px, 7vw, 74px);
      font-weight: 700;
      line-height: 0.98;
      margin-bottom: 20px;
      max-width: 820px;
    }
    .hero-sub {
      font-size: 15px;
      color: var(--muted);
      border-left: 4px solid var(--line);
      padding-left: 14px;
      line-height: 1.75;
      max-width: 620px;
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 24px;
    }
    .hero-link {
      display: inline-flex;
      align-items: center;
      min-height: 38px;
      border: 2px solid var(--line);
      box-shadow: 3px 3px 0 var(--line);
      padding: 0 13px;
      background: var(--ink);
      color: var(--paper);
      font-family: var(--mono);
      font-size: 12px;
      font-weight: 700;
      text-decoration: none;
      text-transform: uppercase;
    }
    .hero-link.secondary {
      background: var(--paper);
      color: var(--ink);
    }
    .hero-link:hover {
      transform: translate(1px, 1px);
      box-shadow: 2px 2px 0 var(--line);
    }
    .hero-panel {
      border: 2px solid var(--line);
      box-shadow: 7px 7px 0 var(--line);
      background: #10130f;
      color: #e6f3de;
      min-height: 310px;
      display: flex;
      flex-direction: column;
    }
    .terminal-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid var(--line);
      background: var(--paper-2);
      color: var(--ink);
      font-family: var(--mono);
      font-size: 11px;
      padding: 8px 10px;
    }
    .terminal-dots {
      display: flex;
      gap: 5px;
    }
    .terminal-dots span {
      width: 9px;
      height: 9px;
      border: 1px solid var(--line);
      background: var(--accent);
      display: block;
    }
    .terminal-body {
      font-family: var(--mono);
      font-size: 12px;
      line-height: 1.8;
      padding: 16px;
      flex: 1;
    }
    .terminal-line { color: #dbead4; }
    .terminal-prompt { color: var(--accent-2); }
    .terminal-muted { color: #93a38d; }
    .terminal-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 16px;
    }
    .terminal-chip {
      border: 1px solid #5f7358;
      background: rgba(157, 255, 110, 0.08);
      padding: 8px;
    }
    .terminal-chip strong {
      display: block;
      color: var(--accent-2);
      font-size: 16px;
      line-height: 1;
      margin-bottom: 5px;
    }
    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1.9fr) 320px;
      border-bottom: 2px solid var(--line);
    }
    .main-col { border-right: 2px solid var(--line); padding: 24px 28px 30px; background: var(--paper); }
    .side-col { padding: 24px 20px 30px; background: var(--paper-2); }
    .col-head {
      font-family: var(--mono);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      border-bottom: 2px solid var(--line);
      padding-bottom: 7px;
      margin-bottom: 18px;
    }
    .post {
      border: 2px solid var(--line);
      padding: 18px;
      margin-bottom: 16px;
      background: #fffaf0;
      box-shadow: 4px 4px 0 var(--line);
    }
    .post:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    .post:last-child {
      border: 2px solid var(--line);
      padding: 18px;
      margin-bottom: 0;
    }
    .post-meta {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 6px;
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
    }
    .post-title { color: var(--ink); font-size: 22px; font-weight: 700; line-height: 1.25; margin-bottom: 8px; text-decoration: none; display: inline; }
    .post-title:hover { background: var(--ink); color: var(--paper); }
    .post-excerpt { font-size: 15px; line-height: 1.75; color: #25231f; margin: 10px 0 12px; max-width: 66ch; }
    .post-tags { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .tag {
      font-family: var(--mono);
      font-size: 10px;
      border: 1px solid var(--line);
      padding: 2px 6px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      text-decoration: none;
      color: var(--ink);
      background: var(--paper);
    }
    .tag:hover { background: var(--ink); color: var(--paper); }
    .tag-invert { background: var(--ink); color: var(--paper); }
    .readmore { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-left: auto; text-decoration: underline; }
    .all-posts { font-size: 12px; margin-top: 22px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
    .all-posts a {
      display: inline-flex;
      border: 1px solid var(--line);
      box-shadow: 2px 2px 0 var(--line);
      padding: 7px 10px;
      background: var(--paper);
      color: var(--ink);
      text-decoration: none;
    }
    .side-section { margin-bottom: 18px; border: 1px solid var(--line); padding: 14px; background: rgba(255, 253, 246, 0.6); }
    .side-section:last-child { border-bottom: none; margin-bottom: 0; }
    .side-section:last-child { border: 1px solid var(--line); }
    .side-head {
      font-family: var(--mono);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      border-bottom: 1px solid var(--line);
      padding-bottom: 6px;
      margin-bottom: 12px;
    }
    .side-item { font-size: 13px; border-bottom: 1px dashed #b8b1a5; padding: 8px 0; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
    .side-item:last-child { border-bottom: none; }
    .side-item a { color: var(--ink); text-decoration: none; flex: 1; }
    .side-item a:hover { text-decoration: underline; background: none; color: var(--ink); }
    .side-item span:last-child { font-family: var(--mono); font-size: 10px; color: var(--muted); white-space: nowrap; }
    .now-item { font-size: 13px; margin-bottom: 8px; line-height: 1.5; }
    .now-item::before { content: "→ "; font-weight: 700; }
    .status-badge {
      display: inline-block;
      font-size: 10px;
      border: 1px solid var(--line);
      padding: 3px 7px;
      margin-bottom: 12px;
      font-family: var(--mono);
      background: var(--paper);
      box-shadow: 2px 2px 0 var(--line);
    }
    .status-badge::before { content: "● "; color: var(--accent); }
    @media (max-width: 880px) {
      .hero-inner { grid-template-columns: 1fr; }
      .hero-panel { min-height: 250px; }
    }
    @media (max-width: 760px) {
      .grid { grid-template-columns: 1fr; }
      .main-col { border-right: none; padding: 20px 14px 24px; }
      .side-col { border-top: 2px solid var(--line); padding: 20px 14px 24px; }
      .hero { padding: 28px 14px 26px; }
      .hero-title { font-size: clamp(38px, 13vw, 58px); }
      .hero-actions { margin-top: 18px; }
      .readmore { width: 100%; margin-left: 0; margin-top: 4px; }
    }
    @media (max-width: 480px) {
      .hero-title { font-size: clamp(34px, 15vw, 48px); }
      .hero-sub { font-size: 14px; }
      .hero-link { width: 100%; justify-content: center; }
      .terminal-grid { grid-template-columns: 1fr; }
    }
  </style>

  <div class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="hero-tag">security notes and lab logs</div>
        <h1 class="hero-title">Phạm Minh Đạt<br>studies systems,<br>writes things down.</h1>
        <p class="hero-sub">Binary exploitation, CTF writeups, and notes from learning offensive security.</p>
        <div class="hero-actions">
          <a class="hero-link" href="/writing">read writing</a>
          <a class="hero-link secondary" href="https://github.com/datpm" target="_blank" rel="noopener">github</a>
        </div>
      </div>
      <aside class="hero-panel" aria-label="current security lab status">
        <div class="terminal-head">
          <span>~/lab/datpm</span>
          <span class="terminal-dots"><span></span><span></span><span></span></span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line"><span class="terminal-prompt">$</span> cat current.txt</div>
          <div class="terminal-line">student at RMIT Vietnam</div>
          <div class="terminal-line"><span class="terminal-prompt">$</span> ls topics</div>
          <div class="terminal-line terminal-muted">pwn, reverse engineering, CTF ops, notes</div>
          <div class="terminal-grid">
            <div class="terminal-chip"><strong>pwn</strong><span>binary exploitation</span></div>
            <div class="terminal-chip"><strong>ctf</strong><span>writeups and prep</span></div>
            <div class="terminal-chip"><strong>rmit</strong><span>student work</span></div>
            <div class="terminal-chip"><strong>logs</strong><span>what I learned</span></div>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <div class="grid">
    <div class="main-col">
      <div class="col-head">latest</div>
      {posts.length === 0 ? (
        <p style="font-size:13px;color:#666;">No posts yet.</p>
      ) : posts.map(post => (
        <article class="post">
          <div class="post-meta">
            <span>{post.data.date.toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric'})}</span>
            <span>{post.data.category}</span>
          </div>
          <a href={`/writing/${post.id}`} class="post-title">{post.data.title}</a>
          <p class="post-excerpt">{post.data.excerpt}</p>
          <div class="post-tags">
            {post.data.tags.map((t: string) => <span class="tag">{t}</span>)}
            <a href={`/writing/${post.id}`} class="readmore">read →</a>
          </div>
        </article>
      ))}
      <div class="all-posts"><a href="/writing">all posts →</a></div>
    </div>

    <div class="side-col">
      <div class="side-section">
        <div class="side-head">now</div>
        <span class="status-badge">current</span>
        <div class="now-item">Working through binary exploitation notes</div>
        <div class="now-item">Helping run CTF activities at RMIT</div>
        <div class="now-item">Reading how2heap and old writeups</div>
        <div class="now-item">Writing clearer postmortems after solves</div>
      </div>
      <div class="side-section">
        <div class="side-head">recent CTFs</div>
        {recentCTFs.map(c => (
          <div class="side-item"><span>{c.name}</span><span>{c.date}</span></div>
        ))}
      </div>
      <div class="side-section">
        <div class="side-head">projects</div>
        {projects.map(p => (
          <div class="side-item"><span>{p.name}</span><span>{p.status}</span></div>
        ))}
      </div>
      <div class="side-section">
        <div class="side-head">links</div>
        <div class="side-item"><a href="https://github.com/datpm" target="_blank" rel="noopener">github</a></div>
        <div class="side-item"><a href="https://ctftime.org" target="_blank" rel="noopener">ctftime</a></div>
        <div class="side-item"><a href="/rss.xml">rss</a></div>
        <div class="side-item"><a href="/about#pgp">pgp key</a></div>
      </div>
    </div>
  </div>

  <Footer />
</Base>
