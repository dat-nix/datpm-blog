---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const recentCTFs = [
  { name: 'TBCTF 2025', date: 'Jun' },
  { name: 'BYUCTF 2026', date: 'May' },
  { name: 'picoCTF', date: 'ongoing' },
];

const projects = [
  { name: 'RMIT CTF Program', status: 'active' },
  { name: 'NCT Workshop', status: 'done' },
  { name: 'this blog', status: 'wip' },
];
---
<Base>
  <Nav />
  <style>
    .hero {
      border-bottom: 2px solid var(--line);
      padding: 28px 18px 24px;
      background:
        linear-gradient(135deg, rgba(10, 127, 63, 0.11), transparent 42%),
        var(--paper);
    }
    .hero-tag {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      border: 1px solid var(--line);
      display: inline-block;
      padding: 3px 8px;
      margin-bottom: 14px;
      background: var(--accent-soft);
      box-shadow: 2px 2px 0 var(--line);
    }
    .hero-title {
      font-size: clamp(34px, 7vw, 64px);
      font-weight: 700;
      line-height: 0.98;
      margin-bottom: 14px;
      max-width: 720px;
    }
    .hero-sub {
      font-size: 14px;
      color: var(--muted);
      border-left: 4px solid var(--line);
      padding-left: 12px;
      line-height: 1.65;
      max-width: 540px;
    }
    .grid {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(240px, 1fr);
      border-bottom: 2px solid var(--line);
    }
    .main-col { border-right: 2px solid var(--line); padding: 22px 18px; }
    .side-col { padding: 22px 18px; background: #f7f4ed; }
    .col-head {
      font-family: var(--mono);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      border-bottom: 2px solid var(--line);
      padding-bottom: 7px;
      margin-bottom: 16px;
    }
    .post { border-bottom: 1px solid var(--line); padding-bottom: 18px; margin-bottom: 18px; }
    .post:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    .post-meta {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 6px;
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
    }
    .post-title { font-size: 19px; font-weight: 700; line-height: 1.25; margin-bottom: 8px; text-decoration: none; display: inline; }
    .post-title:hover { background: var(--ink); color: var(--paper); }
    .post-excerpt { font-size: 14px; line-height: 1.7; color: #25231f; margin: 8px 0 10px; max-width: 62ch; }
    .post-tags { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .tag {
      font-family: var(--mono);
      font-size: 10px;
      border: 1px solid var(--line);
      padding: 2px 6px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      text-decoration: none;
      color: var(--ink);
      background: var(--paper);
    }
    .tag:hover { background: var(--ink); color: var(--paper); }
    .tag-invert { background: var(--ink); color: var(--paper); }
    .readmore { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-left: auto; text-decoration: underline; }
    .all-posts { font-size: 12px; margin-top: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
    .side-section { margin-bottom: 20px; border-bottom: 1px solid var(--line); padding-bottom: 20px; }
    .side-section:last-child { border-bottom: none; margin-bottom: 0; }
    .side-head {
      font-family: var(--mono);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      border-bottom: 2px solid var(--line);
      padding-bottom: 6px;
      margin-bottom: 12px;
    }
    .side-item { font-size: 13px; border-bottom: 1px dashed #b8b1a5; padding: 7px 0; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
    .side-item:last-child { border-bottom: none; }
    .side-item a { color: var(--ink); text-decoration: none; flex: 1; }
    .side-item a:hover { text-decoration: underline; background: none; color: var(--ink); }
    .side-item span:last-child { font-family: var(--mono); font-size: 10px; color: var(--muted); white-space: nowrap; }
    .now-item { font-size: 13px; margin-bottom: 8px; line-height: 1.5; }
    .now-item::before { content: "→ "; font-weight: 700; }
    .status-badge {
      display: inline-block;
      font-size: 10px;
      border: 1px solid var(--line);
      padding: 3px 7px;
      margin-bottom: 12px;
      font-family: var(--mono);
      background: var(--paper);
      box-shadow: 2px 2px 0 var(--line);
    }
    .status-badge::before { content: "● "; color: var(--accent); }
    @media (max-width: 680px) {
      .grid { grid-template-columns: 1fr; }
      .main-col { border-right: none; padding: 18px 12px; }
      .side-col { border-top: 2px solid var(--line); padding: 18px 12px; }
      .hero { padding: 24px 12px 22px; }
      .hero-title { font-size: clamp(32px, 13vw, 52px); }
      .readmore { width: 100%; margin-left: 0; margin-top: 4px; }
    }
  </style>

  <div class="hero">
    <div class="hero-tag">security researcher in progress</div>
    <h1 class="hero-title">Phạm Minh Đạt<br>breaks things,<br>writes about it.</h1>
    <p class="hero-sub">Offensive security · CTF · Bug bounty · Build log<br>Vietnam → internet</p>
  </div>

  <div class="grid">
    <div class="main-col">
      <div class="col-head">latest</div>
      {posts.length === 0 ? (
        <p style="font-size:13px;color:#666;">No posts yet. First one incoming.</p>
      ) : posts.map(post => (
        <article class="post">
          <div class="post-meta">
            <span>{post.data.date.toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric'})}</span>
            <span>{post.data.category}</span>
          </div>
          <a href={`/writing/${post.id}`} class="post-title">{post.data.title}</a>
          <p class="post-excerpt">{post.data.excerpt}</p>
          <div class="post-tags">
            {post.data.tags.map((t: string) => <span class="tag">{t}</span>)}
            <a href={`/writing/${post.id}`} class="readmore">read →</a>
          </div>
        </article>
      ))}
      <div class="all-posts"><a href="/writing">all posts →</a></div>
    </div>

    <div class="side-col">
      <div class="side-section">
        <div class="side-head">now</div>
        <span class="status-badge">online</span>
        <div class="now-item">Grinding binary exploitation</div>
        <div class="now-item">Tổ chức CTF semester tại RMIT</div>
        <div class="now-item">Đọc: how2heap</div>
        <div class="now-item">Target: first bug bounty report</div>
      </div>
      <div class="side-section">
        <div class="side-head">recent CTFs</div>
        {recentCTFs.map(c => (
          <div class="side-item"><span>{c.name}</span><span>{c.date}</span></div>
        ))}
      </div>
      <div class="side-section">
        <div class="side-head">projects</div>
        {projects.map(p => (
          <div class="side-item"><span>{p.name}</span><span>{p.status}</span></div>
        ))}
      </div>
      <div class="side-section">
        <div class="side-head">links</div>
        <div class="side-item"><a href="https://github.com" target="_blank" rel="noopener">github</a></div>
        <div class="side-item"><a href="https://ctftime.org" target="_blank" rel="noopener">ctftime</a></div>
        <div class="side-item"><a href="/rss.xml">rss</a></div>
        <div class="side-item"><a href="/about#pgp">pgp key</a></div>
      </div>
    </div>
  </div>

  <Footer />
</Base>
