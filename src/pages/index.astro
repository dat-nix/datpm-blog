---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const pinned = posts.find(post => post.id === 'cscv2026');
const lead = pinned ?? posts[0];
const secondary = posts.filter(post => post.id !== lead?.id).slice(0, 2);
const tagCounts = posts.flatMap(post => post.data.tags).reduce((counts, tag) => {
  counts[tag] = (counts[tag] || 0) + 1;
  return counts;
}, {});
const popularTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 8);
---

<Base>
  <Nav />
  <style>
    .datpm-home-masthead {
      padding: 54px 0 42px;
    }

    .datpm-home-date,
    .datpm-home-archive-date {
      font: 11px/1.4 var(--meta);
      letter-spacing: .09em;
      text-transform: uppercase;
    }

    .datpm-home-intro {
      max-width: 600px;
      color: var(--muted);
      font-size: 17px;
      line-height: 1.65;
    }

    .datpm-home-links {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      margin-top: 27px;
      font: 12px var(--meta);
    }

    .datpm-home-links a { color: var(--link); text-decoration-thickness: 1px; }

    .datpm-home-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 270px;
      gap: 62px;
      padding: 42px 0 70px;
    }

    .datpm-home-lead { padding-top: 17px; }

    .datpm-home-date,
    .datpm-home-archive-date { color: var(--muted); }

    .datpm-home-lead h2 {
      max-width: 820px;
      margin: 13px 0 15px;
      font: normal clamp(34px, 5vw, 61px)/.98 var(--serif);
      letter-spacing: -.055em;
    }

    .datpm-home-lead h2 a,
    .datpm-home-secondary h3,
    .datpm-home-entry h3,
    .datpm-home-project h3 { text-decoration: none; }

    .datpm-home-lead h2 a:hover,
    .datpm-home-secondary h3 a:hover,
    .datpm-home-entry h3 a:hover,
    .datpm-home-project h3 a:hover { color: var(--accent); }

    .datpm-home-lead p,
    .datpm-home-secondary p,
    .datpm-home-project p { color: var(--muted); }

    .datpm-home-lead p { max-width: 650px; font-size: 17px; line-height: 1.65; }

    .datpm-home-secondary-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 26px;
      margin-top: 38px;
    }

    .datpm-home-secondary { padding-top: 13px; }
    .datpm-home-secondary h3 { margin: 11px 0 9px; font: normal 25px/1.12 var(--serif); letter-spacing: -.035em; }
    .datpm-home-secondary p { font-size: 14px; line-height: 1.55; }

    .datpm-home-rail { display: flex; flex-direction: column; gap: 36px; }
    .datpm-home-rail-section { padding-top: 13px; }
    .datpm-home-project + .datpm-home-project { margin-top: 23px; }
    .datpm-home-project h3 { margin: 0 0 6px; font: normal 23px/1.12 var(--serif); letter-spacing: -.035em; }
    .datpm-home-project p { font: 13px/1.55 var(--serif); }

    .datpm-home-archive { list-style: none; padding: 0; }
    .datpm-home-entry { padding: 14px 0; }
    .datpm-home-entry:first-child { padding-top: 0; }
    .datpm-home-entry h3 { margin-top: 6px; font: normal 19px/1.18 var(--serif); letter-spacing: -.025em; }
    .datpm-home-entry .datpm-home-entry-category { margin-top: 5px; font: 10px var(--meta); color: var(--accent); }

    .datpm-home-tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .datpm-home-tags a { border: 1px solid var(--line); color: var(--accent); font: 10px var(--meta); padding: 5px 7px; text-decoration: none; }
    .datpm-home-tags a:hover { border-color: var(--accent); color: var(--ink); }
    .datpm-home-tags small { color: var(--muted); }

    @media (max-width: 760px) {
      .datpm-home-masthead { padding: 42px 0 35px; }
      .datpm-home-intro { font-size: 16px; }
      .datpm-home-layout { grid-template-columns: 1fr; gap: 48px; padding-top: 34px; }
      .datpm-home-rail { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 28px; }
      .datpm-home-rail .datpm-home-rail-section:last-child { grid-column: 1 / -1; }
    }

    @media (max-width: 520px) {
      .datpm-home-intro { font-size: 15px; }
      .datpm-home-secondary-list,
      .datpm-home-rail { grid-template-columns: 1fr; }
      .datpm-home-rail .datpm-home-rail-section:last-child { grid-column: auto; }
      .datpm-home-lead h2 { font-size: 36px; }
      .datpm-home-secondary h3 { font-size: 24px; }
    }
  </style>

  <main>
    <header class="datpm-home-masthead">
      <p class="datpm-home-intro">
        CTF writeups, security experiments, and the occasional rabbit hole that took longer than it should have.
      </p>
      <nav class="datpm-home-links" aria-label="Homepage links">
        <a href="/writing">read the archive →</a>
        <a href="https://www.linkedin.com/in/dat-pham-7a54653b8/" target="_blank" rel="noopener">linkedin ↗</a>
      </nav>
    </header>

    <div class="datpm-home-layout">
      <section aria-label="Pinned writing">
        {lead && <article class="datpm-home-lead">
          <h2><a href={`/writing/${lead.id}`}>{lead.data.title}</a></h2>
          <p>{lead.data.excerpt}</p>
        </article>}

        <div class="datpm-home-secondary-list">
          {secondary.map(post => <article class="datpm-home-secondary">
            <time class="datpm-home-date" datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</time>
            <h3><a href={`/writing/${post.id}`}>{post.data.title}</a></h3>
            <p>{post.data.excerpt}</p>
          </article>)}
        </div>

      </section>

      <aside class="datpm-home-rail" aria-label="About and archive">
        <section class="datpm-home-rail-section">
          <article class="datpm-home-project">
            <h3><a href="/writing">A working archive</a></h3>
            <p>Technical notes written from real artifacts: source, solver, terminal output, screenshots, and the mistakes between them.</p>
          </article>
        </section>

        <section class="datpm-home-rail-section">
          <ul class="datpm-home-archive">
            {posts.map(post => <li class="datpm-home-entry">
              <time class="datpm-home-archive-date" datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</time>
              <h3><a href={`/writing/${post.id}`}>{post.data.title}</a></h3>
              <div class="datpm-home-entry-category">{post.data.category}</div>
            </li>)}
          </ul>
        </section>

        <section class="datpm-home-rail-section">
          <div class="datpm-home-tags">
            {popularTags.map(([tag, count]) => <a href={`/writing?tag=${encodeURIComponent(tag)}`}>#{tag} <small>{count}</small></a>)}
          </div>
        </section>

      </aside>
    </div>
  </main>

  <Footer />
</Base>
