---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter(post => !/^0[1-8-]|^11-/.test(post.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const groups = [...new Set(posts.map(post => post.data.ctf || post.data.category))];
const tagCounts = posts.flatMap(post => post.data.tags).reduce((counts: Record<string, number>, tag) => {
  counts[tag] = (counts[tag] || 0) + 1;
  return counts;
}, {});
const techniques = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 18);
---

<Base title="writing">
  <Nav />
  <style>
    .datpm-writing-head { padding: 58px 0 36px; }
    .datpm-writing-head h1 { font: normal clamp(48px, 8vw, 82px)/.95 var(--serif); letter-spacing: -.06em; margin: 0 0 16px; }
    .datpm-writing-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding: 20px 0 12px; }
    .datpm-writing-search { flex: 1 1 240px; border: 1px solid var(--line); background: var(--paper); color: var(--ink); padding: 11px 12px; font: 13px var(--meta); }
    .datpm-writing-search:focus { outline: 2px solid var(--accent); outline-offset: 2px; }
    .datpm-writing-stats { font: 11px var(--meta); color: var(--muted); }
    .datpm-writing-filter-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; padding: 0 0 12px; }
    .datpm-writing-filter-chip { border: 1px solid var(--line); background: transparent; color: var(--accent); cursor: pointer; padding: 5px 7px; font: 10px var(--meta); }
    .datpm-writing-filter-chip small { color: var(--muted); }
    .datpm-writing-filter-chip:hover, .datpm-writing-filter-chip.active { border-color: var(--accent); background: var(--wash); color: var(--ink); }
    .datpm-writing-list { max-width: 760px; padding: 30px 0 70px; }
    .datpm-writing-group { margin-bottom: 38px; }
    .datpm-writing-group-title { font: 12px var(--meta); color: var(--ink); letter-spacing: .1em; text-transform: uppercase; margin-bottom: 2px; }
    .datpm-writing-row { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 18px; padding: 18px 0; }
    .datpm-writing-date { font: 11px var(--meta); color: var(--muted); padding-top: 3px; }
    .datpm-writing-title { font: normal 24px/1.15 var(--serif); text-decoration: none; }
    .datpm-writing-title:hover { color: var(--accent); }
    .datpm-writing-meta { font: 11px var(--meta); color: var(--muted); margin-top: 8px; }
    @media (max-width: 700px) {
      .datpm-writing-head { padding: 44px 0 30px; }
      .datpm-writing-list { padding-top: 24px; }
      .datpm-writing-row { grid-template-columns: 1fr; gap: 6px; }
      .datpm-writing-title { font-size: 22px; }
    }
  </style>

  <main>
    <header class="datpm-writing-head">
      <h1>writing</h1>
    </header>
    <div class="datpm-writing-tools">
      <input class="datpm-writing-search" id="writeup-search" type="search" placeholder="Search writeups or techniques…" aria-label="Search writeups" />
      <span class="datpm-writing-stats">{groups.length} collections · {posts.length} posts · {Object.keys(tagCounts).length} methods</span>
    </div>
    <div class="datpm-writing-filter-bar" aria-label="Filter by technique">
      <button class="datpm-writing-filter-chip active" type="button" data-filter-tag="">all</button>
      {techniques.map(([tag, count]) => <button class="datpm-writing-filter-chip" type="button" data-filter-tag={tag}>{tag} <small>{count}</small></button>)}
    </div>
    <div class="datpm-writing-list">
      <section id="writeup-list">
        {groups.map(group => <section class="datpm-writing-group" data-group={group}>
          <h2 class="datpm-writing-group-title">{group}</h2>
          {posts.filter(post => (post.data.ctf || post.data.category) === group).map(post => <article class="datpm-writing-row" data-search={`${post.data.title} ${post.data.category} ${post.data.tags.join(' ')}`} data-tags={post.data.tags.join(' ')}>
            <time class="datpm-writing-date" datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</time>
            <div>
              <a class="datpm-writing-title" href={`/writing/${post.id}`}>{post.data.title}</a>
              <div class="datpm-writing-meta">{post.data.category}</div>
            </div>
          </article>)}
        </section>)}
      </section>
    </div>
  </main>

  <script is:inline>
    const input = document.querySelector('#writeup-search');
    const filters = [...document.querySelectorAll('[data-filter-tag]')];
    let activeTag = new URLSearchParams(window.location.search).get('tag') || '';
    const applyFilters = () => {
      const query = input?.value.toLowerCase().trim() || '';
      document.querySelectorAll('[data-search]').forEach((row) => {
        const tagMatch = !activeTag || row.dataset.tags?.split(' ').includes(activeTag);
        const textMatch = !query || row.dataset.search.toLowerCase().includes(query);
        row.hidden = !(tagMatch && textMatch);
      });
      document.querySelectorAll('[data-group]').forEach((group) => {
        group.hidden = !group.querySelector('[data-search]:not([hidden])');
      });
      filters.forEach((filter) => filter.classList.toggle('active', filter.dataset.filterTag === activeTag));
    };
    input?.addEventListener('input', applyFilters);
    filters.forEach((filter) => filter.addEventListener('click', () => {
      activeTag = filter.dataset.filterTag || '';
      const url = new URL(window.location.href);
      if (activeTag) url.searchParams.set('tag', activeTag); else url.searchParams.delete('tag');
      window.history.replaceState({}, '', url);
      applyFilters();
    }));
    applyFilters();
  </script>
  <Footer />
</Base>
