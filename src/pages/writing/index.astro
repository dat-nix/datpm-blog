---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="writing">
  <Nav />
  <style>
    .page-head {
      border-bottom: 2px solid var(--line);
      padding: clamp(28px, 5vw, 54px) 28px 28px;
      background:
        linear-gradient(135deg, rgba(17, 107, 69, 0.18), transparent 48%),
        linear-gradient(180deg, var(--paper), #f5f1e7),
        var(--paper);
    }
    .page-head h1 { font-size: clamp(42px, 7vw, 72px); font-weight: 700; line-height: 0.98; }
    .page-head p { font-size: 15px; color: var(--muted); margin-top: 10px; line-height: 1.65; max-width: 680px; }
    .post-list { padding: 0; }
    .post-row {
      display: grid;
      grid-template-columns: 130px minmax(0, 1fr) auto;
      gap: 0 20px;
      align-items: baseline;
      border-bottom: 1px solid var(--line);
      padding: 18px 28px;
      font-size: 14px;
      background: var(--paper);
      transition: background 120ms ease, padding-left 120ms ease;
    }
    .post-row:hover { background: var(--paper-2); padding-left: 34px; }
    .post-row:last-child { border-bottom: none; }
    .post-date { font-size: 11px; color: var(--muted); font-family: var(--mono); white-space: nowrap; }
    .post-title { font-size: 18px; font-weight: 700; text-decoration: none; line-height: 1.3; }
    .post-title:hover { background: var(--ink); color: var(--paper); }
    .post-cat { font-family: var(--mono); font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; white-space: nowrap; }
    .post-tags { display: flex; gap: 5px; margin-top: 6px; flex-wrap: wrap; }
    .tag {
      font-family: var(--mono);
      font-size: 10px;
      border: 1px solid var(--line);
      padding: 2px 6px;
      text-transform: uppercase;
      background: var(--paper);
    }
    .post-inner { display: flex; flex-direction: column; }
    @media (max-width: 900px) {
      .post-row {
        grid-template-columns: 112px minmax(0, 1fr);
      }
      .post-cat {
        grid-column: 2;
        margin-top: 2px;
      }
    }
    @media (max-width: 700px) {
      .page-head { padding: 28px 14px 20px; }
      .post-row {
        grid-template-columns: 1fr;
        gap: 8px;
        padding: 16px 14px;
      }
      .post-row:hover { padding-left: 14px; }
      .post-cat { justify-self: start; }
    }
  </style>

  <div class="page-head">
    <h1>writing</h1>
    <p>{posts.length} posts · CTF writeups, security research, build logs, rants</p>
  </div>

  <div class="post-list">
    {posts.map(post => (
      <div class="post-row">
        <span class="post-date">
          {post.data.date.toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'})}
        </span>
        <div class="post-inner">
          <a href={`/writing/${post.id}`} class="post-title">{post.data.title}</a>
          <div class="post-tags">
            {post.data.tags.map((t: string) => <span class="tag">{t}</span>)}
          </div>
        </div>
        <span class="post-cat">{post.data.category.split(' · ')[0]}</span>
      </div>
    ))}
  </div>

  <Footer />
</Base>
